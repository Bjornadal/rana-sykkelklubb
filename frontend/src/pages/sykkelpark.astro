    color: "border-primary-500 text-primary-700 bg-primary-50/50",
  },
  {
    label: "Partnerløftet",
    value: "1,3 mill. kr",
    note: "Mål for nye sponsor- og gavebidrag",
    color: "border-blue-500 text-blue-700 bg-blue-50/50",
  },
  {
    label: "Planlagt byggestart",
    value: "Mai 2027",
    note: "Avhengig av finansiering og tillatelser",
    color: "border-amber-500 text-amber-700 bg-amber-50/50",
  },
