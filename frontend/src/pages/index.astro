---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import DisciplineCard from "../components/DisciplineCard.astro";
import NewsCard from "../components/NewsCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { url } from "../lib/url";
import { fetchNews } from "../lib/content";

const disciplines = [
  {
    title: "Landevei",
    description:
      "Fellestreninger, turritt og satsing mot nasjonale mesterskap. For deg som elsker farten og asfalten.",
    icon: "🚴",
    color: "bg-blue-100 text-blue-600",
  },
  {
    title: "Terrengsykling (MTB)",
    description:
      "Stisykling og terrengritt i fantastisk natur på Helgeland. Teknikk, spenning og naturopplevelser.",
    icon: "🏔️",
    color: "bg-green-100 text-green-600",
  },
  {
    title: "E-MTB",
    description:
      "Elektrisk terrengsykling for alle nivåer. En perfekt måte å utforske naturen med litt ekstra hjelp.",
    icon: "⚡",
    color: "bg-yellow-100 text-yellow-600",
  },
  {
    title: "Enduro",
    description:
      "Tekniske stier og fartsfylte utforkjøringer. For deg som søker utfordringer og adrenalinkick.",
    icon: "🔥",
    color: "bg-red-100 text-red-600",
  },
];

const latestNews = (await fetchNews()).slice(0, 3);
---

<Layout title="Forside">
  <Hero
    title="Sykkelglede for alle på Helgeland"
    subtitle="Rana Sykkelklubb har fremmet sykkelsporten i Rana siden 1983. Vi tilbyr et bredt og aktivt sykkelmiljø for barn, ungdom og voksne – på asfalt, grus og sti."
    cta={{ label: "Bli medlem", href: "/medlemskap" }}
    ctaSecondary={{ label: "Se aktiviteter", href: "/aktiviteter" }}
  />

  <!-- Rana Bike Park (Fremhevet høyt oppe) -->
  <section class="bg-gray-50 py-16 sm:py-24 border-b border-gray-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <span class="inline-block rounded-full bg-primary-100 px-4 py-1 text-xs font-bold uppercase tracking-wider text-primary-700">
            Nytt storsatsingsprosjekt
          </span>
          <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-dark sm:text-4xl">
            Rana Bike Park – Fremtidens møteplass
          </h2>
          <p class="mt-4 text-base sm:text-lg leading-relaxed text-gray-600">
            Vi jobber for å skape en inkluderende sykkelpark med pumptrack, hoppanlegg og
            flytstier. Parken skal gi glede, mestring og aktivitet for barn, ungdom og voksne.
          </p>
          <ul class="mt-6 space-y-3">
            {["Pumptrack for alle nivåer og aldre", "Hoppanlegg med ulike vanskelighetsgrader", "Flytstier i naturskjønne omgivelser i Båsmofjellet / Munklia", "Fase 1 sikret med 8,75 MNOK gjennom Anleggsløftet"].map((item) => (
              <li class="flex items-start gap-3 text-sm font-medium text-gray-700">
                <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href={url("/sykkelpark")}
              class="inline-flex items-center rounded-xl bg-primary-600 px-6 py-3 text-sm font-bold uppercase tracking-wider text-white shadow-md transition-all hover:bg-primary-500 hover:-translate-y-0.5"
            >
              Les mer om Rana Bike Park &rarr;
            </a>
            <a
              href={url("/nyheter/875-millioner-kroner-til-rana-bike-park")}
              class="inline-flex items-center rounded-xl border border-gray-300 bg-white px-5 py-3 text-sm font-bold text-gray-700 shadow-2xs transition-all hover:bg-gray-50"
            >
              Les pressemeldingen
            </a>
          </div>
        </div>
        <div class="relative">
          <a href={url("/rana-bike-park-map.jpg")} target="_blank" rel="noopener noreferrer" class="group block overflow-hidden rounded-2xl shadow-xl border border-gray-200 transition-shadow hover:shadow-2xl">
            <img
              src={url("/rana-bike-park-map.jpg")}
              alt="Illustrasjon av Rana Bike Park – oversiktskart over anlegget i Munklia og Båsmofjellet"
              class="h-auto w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
              loading="lazy"
            />
            <span class="absolute bottom-3 right-3 flex items-center gap-1.5 rounded-lg bg-black/60 px-3 py-1.5 text-xs font-medium text-white opacity-0 backdrop-blur-sm transition-opacity group-hover:opacity-100">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
              </svg>
              Vis fullstørrelse
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Disipliner -->
  <section class="py-16 sm:py-24 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Våre disipliner"
        subtitle="Enten du foretrekker glatt asfalt eller tekniske stier – vi har noe for deg."
      />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {disciplines.map((d) => (
          <DisciplineCard
            title={d.title}
            description={d.description}
            icon={d.icon}
            color={d.color}
          />
        ))}
      </div>
      <div class="mt-10 text-center">
        <a
          href={url("/ruter")}
          class="inline-flex items-center gap-2 rounded-xl border border-gray-300 bg-white px-6 py-3 text-sm font-bold uppercase tracking-wider text-dark shadow-2xs transition-all hover:border-primary-400 hover:bg-primary-50 hover:text-primary-700"
        >
          <span>Utforsk stier og turforslag</span>
          <svg class="h-4 w-4 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Rute- & Stibibliotek Feature Card -->
  <section class="border-t border-gray-100 bg-gray-50 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-dark via-dark-light to-primary-950 px-6 py-12 text-white shadow-2xl sm:px-12 sm:py-16">
        <div class="relative z-10 grid items-center gap-8 lg:grid-cols-12">
          <div class="lg:col-span-8">
            <span class="inline-block rounded-full bg-primary-500/80 px-4 py-1 text-xs font-bold uppercase tracking-wider text-white">
              Nyhet: Stibibliotek
            </span>
            <h2 class="mt-4 text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">
              Oppdag de beste stiene i Mo i Rana
            </h2>
            <p class="mt-4 max-w-2xl text-base sm:text-lg text-gray-200">
              Vi har samlet og kartlagt de 16 råeste singletracks og stiturene i Rana. Last ned gratis GPX-spor rett til din sykkelcomputer eller mobil.
            </p>
            <div class="mt-6 flex flex-wrap gap-4 text-xs font-bold uppercase tracking-wider text-gray-300">
              <span class="flex items-center gap-1.5"><span class="text-primary-400">✓</span> Idavollen Flytsti</span>
              <span class="flex items-center gap-1.5"><span class="text-primary-400">✓</span> Hauknestinden Topptur</span>
              <span class="flex items-center gap-1.5"><span class="text-primary-400">✓</span> Ytternmarka Roundtrip</span>
              <span class="flex items-center gap-1.5"><span class="text-primary-400">✓</span> Tindan i Dalsgrenda</span>
            </div>
          </div>
          <div class="flex lg:col-span-4 lg:justify-end">
            <a
              href={url("/ruter")}
              class="inline-flex items-center justify-center rounded-xl bg-primary-500 px-7 py-4 text-sm font-bold uppercase tracking-wider text-white shadow-lg transition-all hover:bg-primary-600 hover:-translate-y-0.5 hover:shadow-primary-500/40"
            >
              Utforsk alle stier &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nyheter -->
  <section class="py-16 sm:py-24 bg-white border-t border-gray-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Siste nyheter"
        subtitle="Hold deg oppdatert på hva som skjer i klubben."
      />
      {latestNews.length > 0 ? (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {latestNews.map((news) => (
            <NewsCard
              title={news.title}
              excerpt={news.excerpt}
              date={news.date}
              slug={news.slug}
              image={news.image}
            />
          ))}
        </div>
      ) : (
        <p class="text-center text-gray-500">Ingen nyheter for øyeblikket.</p>
      )}
      <div class="mt-12 text-center">
        <a
          href={url("/nyheter")}
          class="inline-flex items-center rounded-lg border border-gray-300 px-6 py-3 text-base font-semibold text-dark transition-all hover:border-primary-300 hover:bg-primary-50 hover:text-primary-700"
        >
          Se alle nyheter
          <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary-600">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="text-center">
        <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Bli en del av sykkelmiljøet i Rana
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-primary-100">
          Uansett om du er nybegynner eller erfaren – det er plass til deg hos oss.
          Medlemskapet gir deg tilgang til treninger, rabatter og et flott fellesskap.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a
            href={url("/medlemskap")}
            class="inline-flex items-center rounded-lg bg-white px-6 py-3 text-base font-semibold text-primary-700 shadow transition-all hover:bg-gray-50"
          >
            Meld deg inn i dag
          </a>
          <a
            href={url("/kontakt")}
            class="inline-flex items-center rounded-lg border border-primary-300 px-6 py-3 text-base font-semibold text-white transition-all hover:bg-primary-500"
          >
            Ta kontakt
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
