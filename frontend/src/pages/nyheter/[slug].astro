---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { url } from "../../lib/url";

export async function getStaticPaths() {
  const news = await getCollection("nyheter");
  return news.map((article) => ({
    params: { slug: article.id.replace(/\.[^/.]+$/, "") },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const formattedDate = new Date(article.data.date).toLocaleDateString("nb-NO", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout title={article.data.title} description={article.data.excerpt}>
  <article>
    <header class="bg-gradient-to-br from-dark via-dark-light to-primary-900 py-20 sm:py-28">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <a
          href={url("/nyheter")}
          class="inline-flex items-center gap-1 text-sm text-gray-400 transition-colors hover:text-white"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Tilbake til nyheter
        </a>
        <time datetime={article.data.date.toISOString()} class="mt-6 block text-sm font-medium text-primary-400 uppercase tracking-wide">
          {formattedDate}
        </time>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl">
          {article.data.title}
        </h1>
      </div>
    </header>

    {article.data.image && (
      <div class="mx-auto -mt-8 max-w-4xl px-4 sm:px-6 lg:px-8">
        <img
          src={url(article.data.image)}
          alt={article.data.title}
          class="w-full rounded-2xl shadow-xl"
          loading="eager"
        />
      </div>
    )}

    <div class="py-12 sm:py-16">
      <div class="prose prose-lg mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <Content />
      </div>
    </div>
  </article>
</Layout>
