---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import OverviewMap from "../../components/OverviewMap.astro";
import { fetchRoutes } from "../../lib/content";
import { url } from "../../lib/url";

const allRoutes = await fetchRoutes();
// Filter to only Terreng / Sti routes and sort trails with images first
const routes = allRoutes
  .filter((r) => r.discipline === "Terreng / Sti")
  .sort((a, b) => {
    const hasImageA = a.image ? 1 : 0;
    const hasImageB = b.image ? 1 : 0;
    if (hasImageB !== hasImageA) {
      return hasImageB - hasImageA;
    }
    return (a.order ?? 0) - (b.order ?? 0);
  });

const totalKm = routes.reduce((acc, r) => acc + r.distanceKm, 0);
const totalElevation = routes.reduce((acc, r) => acc + r.elevationM, 0);

const disciplineColors: Record<string, { bg: string; text: string; border: string; icon: string }> = {
  "Terreng / Sti": { bg: "bg-green-50", text: "text-green-700", border: "border-green-200", icon: "🏔️" },
  "Grus / Gravel": { bg: "bg-amber-50", text: "text-amber-700", border: "border-amber-200", icon: "🌾" },
};

const difficultyColors: Record<string, { bg: string; text: string; dot: string }> = {
  Enkel: { bg: "bg-emerald-100", text: "text-emerald-800", dot: "bg-emerald-500" },
  Middels: { bg: "bg-blue-100", text: "text-blue-800", dot: "bg-blue-500" },
  Krevende: { bg: "bg-rose-100", text: "text-rose-800", dot: "bg-rose-500" },
  Ekspert: { bg: "bg-slate-900", text: "text-white", dot: "bg-red-500" },
};
---

<Layout
  title="Stibibliotek | Terrengsykling i Mo i Rana"
  description="Utforsk de 15 beste stiene for stisykling i Rana og på Helgeland. Last ned gratis GPX-spor for singletrack og toppturer."
>
  <PageHeader
    title="Stibibliotek"
    description="De 15 beste stiene for stisykling i Mo i Rana – med stiguider, høydeprofil, Trailguide-referanser og gratis GPX-nedlasting for sykkelcomputere."
  />

  <!-- Stats Banner -->
  <section class="relative z-10 -mt-8 sm:-mt-12 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 shadow-xl">
        <div class="text-center sm:border-r sm:border-gray-100 p-2">
          <span class="block text-xs font-bold uppercase tracking-wider text-gray-500">Stier i Rana</span>
          <span class="mt-1 block text-2xl sm:text-3xl font-black text-dark">{routes.length} stier</span>
        </div>
        <div class="text-center sm:border-r sm:border-gray-100 p-2">
          <span class="block text-xs font-bold uppercase tracking-wider text-gray-500">Singletrack &amp; Flyt</span>
          <span class="mt-1 block text-2xl sm:text-3xl font-black text-primary-600">{totalKm.toFixed(1)} km</span>
        </div>
        <div class="text-center p-2">
          <span class="block text-xs font-bold uppercase tracking-wider text-gray-500">Samlet stigning/fall</span>
          <span class="mt-1 block text-2xl sm:text-3xl font-black text-dark">{totalElevation.toLocaleString("nb-NO")} hm</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Map Section -->
  <section class="pt-12 pb-4 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <OverviewMap />
    </div>
  </section>

  <!-- Filter & Search Controls -->
  <section class="py-8 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between border-b border-gray-100 pb-8">
        
        <!-- Category Badge -->
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-2 rounded-2xl bg-green-50 border border-green-200 px-4 py-2 text-xs font-bold uppercase tracking-wider text-green-800 shadow-2xs">
            <span>🏔️</span>
            <span>Viser de 15 beste stiene i Rana</span>
          </span>
        </div>

        <!-- Search Input & Difficulty Filter -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="relative min-w-[240px] flex-1 sm:flex-initial">
            <input
              type="text"
              id="route-search"
              placeholder="Søk i stier, områder, Trailguide..."
              class="w-full rounded-xl border border-gray-200 bg-gray-50 py-2.5 pl-10 pr-4 text-sm text-dark placeholder-gray-400 focus:border-primary-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-primary-500/20"
            />
            <svg class="absolute left-3.5 top-3 h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
            </svg>
          </div>

          <select
            id="difficulty-filter"
            aria-label="Filtrer etter vanskelighetsgrad"
            class="rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-xs font-bold uppercase tracking-wider text-gray-700 focus:border-primary-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-primary-500/20"
          >
            <option value="all">Alle vanskelighetsgrader</option>
            <option value="Enkel">Grønn / Enkel</option>
            <option value="Middels">Blå / Middels</option>
            <option value="Krevende">Rød / Krevende</option>
          </select>
        </div>
      </div>

      <!-- Route Cards Grid -->
      <div class="mt-8 grid gap-8 md:grid-cols-2 lg:grid-cols-3" id="routes-grid">
        {routes.map((route) => {
          const disc = disciplineColors[route.discipline] || { bg: "bg-gray-50", text: "text-gray-700", border: "border-gray-200", icon: "🚲" };
          const diff = difficultyColors[route.difficulty] || { bg: "bg-gray-100", text: "text-gray-700", dot: "bg-gray-400" };

          return (
            <article
              class="route-card group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-xs transition-all duration-200 hover:-translate-y-1 hover:shadow-xl hover:border-primary-200"
              data-discipline={route.discipline}
              data-difficulty={route.difficulty}
              data-title={route.title.toLowerCase()}
              data-search={`${route.title} ${route.excerpt} ${route.startingPoint} ${route.surface} ${route.highlights.join(" ")}`.toLowerCase()}
            >
              <!-- Card Header Badge Bar -->
              <div class="flex items-center justify-between border-b border-gray-100 bg-gray-50/70 px-6 py-3.5">
                <span class={`inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-1 text-xs font-bold uppercase tracking-wider ${disc.bg} ${disc.text} ${disc.border}`}>
                  <span>{disc.icon}</span>
                  <span>{route.discipline}</span>
                </span>
                
                <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold ${diff.bg} ${diff.text}`}>
                  <span class={`h-2 w-2 rounded-full ${diff.dot}`}></span>
                  {route.difficulty}
                </span>
              </div>

              {route.image && (
                <div class="relative h-48 w-full overflow-hidden bg-gray-100 border-b border-gray-100">
                  <img
                    src={url(route.image)}
                    alt={route.title}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              )}

              <!-- Card Content -->
              <div class="flex flex-1 flex-col p-6 sm:p-7">
                <div class="flex-1">
                  <h3 class="text-xl font-bold tracking-tight text-dark group-hover:text-primary-600 transition-colors">
                    <a href={url(`/ruter/${route.slug}`)}>
                      {route.title}
                    </a>
                  </h3>
                  <p class="mt-2.5 line-clamp-2 text-sm leading-relaxed text-gray-600">
                    {route.excerpt}
                  </p>
                </div>

                <!-- Route Metrics Grid -->
                <div class="mt-6 grid grid-cols-2 gap-2 rounded-xl bg-gray-50 p-3 text-center border border-gray-100">
                  <div>
                    <span class="block text-2xs font-semibold uppercase text-gray-400">Distanse</span>
                    <span class="mt-0.5 block text-sm font-extrabold text-dark">{route.distanceKm} km</span>
                  </div>
                  <div class="border-l border-gray-200">
                    <span class="block text-2xs font-semibold uppercase text-gray-400">Høyde</span>
                    <span class="mt-0.5 block text-sm font-extrabold text-dark">{route.elevationM} hm</span>
                  </div>
                </div>

                <!-- Starting point & Surface -->
                <div class="mt-4 space-y-1.5 text-xs text-gray-500">
                  <div class="flex items-center gap-2">
                    <svg class="h-4 w-4 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span class="truncate"><strong>Start:</strong> {route.startingPoint}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <svg class="h-4 w-4 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                    </svg>
                    <span class="truncate"><strong>Underlag:</strong> {route.surface}</span>
                  </div>
                </div>

                <!-- Highlights tags -->
                {route.highlights.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {route.highlights.slice(0, 2).map((h: string) => (
                      <span class="rounded-md bg-gray-100 px-2 py-0.5 text-2xs font-medium text-gray-600">
                        {h}
                      </span>
                    ))}
                  </div>
                )}

                <!-- Card Footer Actions -->
                <div class="mt-6 flex items-center justify-between border-t border-gray-100 pt-4">
                  <a
                    href={url(`/ruter/${route.slug}`)}
                    class="text-xs font-bold uppercase tracking-wider text-primary-600 group-hover:text-primary-700 inline-flex items-center gap-1"
                  >
                    Se stiguide &rarr;
                  </a>
                  
                  {route.gpxFile && (
                    <a
                      href={url(route.gpxFile)}
                      download
                      class="inline-flex items-center gap-1.5 rounded-lg bg-gray-100 px-3 py-1.5 text-xs font-bold text-gray-700 hover:bg-primary-50 hover:text-primary-700 transition-colors"
                      title="Last ned GPX-spor"
                    >
                      <svg class="h-3.5 w-3.5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                      </svg>
                      <span>GPX</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- No routes message -->
      <div id="no-routes-message" class="hidden my-16 text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-gray-100 text-3xl">
          🔍
        </div>
        <h3 class="mt-4 text-lg font-bold text-dark">Ingen stier matcher søkekriteriene dine</h3>
        <p class="mt-1 text-sm text-gray-500">Prøv å endre søkeord eller tilbakestill filtrene.</p>
        <button
          type="button"
          id="reset-filters-btn"
          class="mt-4 inline-flex items-center rounded-xl bg-primary-600 px-4 py-2 text-xs font-bold uppercase tracking-wider text-white shadow-xs hover:bg-primary-500"
        >
          Nullstill filtre
        </button>
      </div>
    </div>
  </section>

  <!-- Trailguide & Trailforks Hub Section -->
  <section class="border-t border-gray-100 bg-gray-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-gradient-to-br from-dark via-dark-light to-primary-950 p-8 sm:p-12 text-white shadow-2xl">
        <div class="grid items-center gap-8 lg:grid-cols-12">
          <div class="lg:col-span-8">
            <span class="inline-block rounded-full bg-primary-500/80 px-4 py-1 text-xs font-bold uppercase tracking-wider text-white">
              Digitale Stiguider &amp; Føremeldinger
            </span>
            <h2 class="mt-4 text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">
              Trailguide &amp; Trailforks Mo i Rana
            </h2>
            <p class="mt-4 max-w-2xl text-base text-gray-300 leading-relaxed">
              Rana Sykkelklubb samarbeider med stimiljøet og anbefaler Trailguide og Trailforks for sanntids oppdateringer, detaljerte kart og føremeldinger.
            </p>
            <div class="mt-6 flex flex-wrap gap-4">
              <a
                href="https://trailguide.net/html/Norway/Nordland/Rana"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl bg-primary-500 px-6 py-3 text-sm font-bold uppercase tracking-wider text-white shadow-md hover:bg-primary-600 transition-all"
              >
                <span>🏔️</span>
                <span>Åpne Trailguide Rana &rarr;</span>
              </a>
              <a
                href="https://www.trailforks.com/region/mo-i-rana-29667/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-6 py-3 text-sm font-bold uppercase tracking-wider text-white shadow-md hover:bg-white/20 transition-all backdrop-blur-xs"
              >
                <span>🗺️</span>
                <span>Åpne Trailforks Mo i Rana &rarr;</span>
              </a>
            </div>
          </div>
          <div class="lg:col-span-4 flex justify-center">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xs text-center max-w-xs">
              <span class="text-4xl">🌲</span>
              <h4 class="mt-3 font-bold text-white">Opplev Helgelands stier</h4>
              <p class="mt-2 text-xs text-gray-300">
                Fra flytstiene i Båsmofjellet og Ytternmarka til snaufjellsturer på Hauknestinden, Reinfjellet og Tindan.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stivett & Ferdsel Section (NOTS Official) -->
  <section class="border-t border-gray-100 bg-gray-50 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-block rounded-full bg-emerald-100 px-4 py-1 text-xs font-bold uppercase tracking-wider text-emerald-800">
          Sporløs ferdsel &amp; godt samspill
        </span>
        <h2 class="mt-3 text-3xl font-extrabold text-dark sm:text-4xl">
          Stivettreglene (NOTS)
        </h2>
        <blockquote class="mt-4 text-base italic text-gray-700 font-medium">
          «Det å ha flotte stier å sykle på er ikke en rettighet, men et privilegium.»
        </blockquote>
        <p class="mt-2 text-sm text-gray-600">
          Rana Sykkelklubb oppfordrer alle stisyklister til å følge NOTS sine nasjonale retningslinjer for å ta vare på stiene og skape gode opplevelser for alle i naturen.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
        <!-- På barmark (10 regler) -->
        <div class="rounded-2xl border border-gray-200 bg-white p-6 sm:p-8 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-100">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-xl text-emerald-700">
                🌲
              </span>
              <div>
                <h3 class="text-lg font-bold text-dark">På barmark (10 regler)</h3>
                <p class="text-xs text-gray-500">For stisykling vår, sommer og høst</p>
              </div>
            </div>

            <ol class="space-y-3.5 text-xs sm:text-sm text-gray-700">
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-[11px] font-bold text-emerald-800">1</span>
                <span>Vær omtenksom og hyggelig i møte med turgåere.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-[11px] font-bold text-emerald-800">2</span>
                <span><strong>Du har alltid vikeplikt for fotgjengere.</strong></span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-[11px] font-bold text-emerald-800">3</span>
                <span>Begrens farten slik at du ikke er til fare eller ulempe for andre, særlig langs veier og stier som innbyr til høy hastighet, eller i uoversiktlige partier.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-[11px] font-bold text-emerald-800">4</span>
                <span>Brems ned til gangfart i god tid før du passerer andre på en smal sti.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-[11px] font-bold text-emerald-800">5</span>
                <span>Ikke lag nye spor. Dersom du ikke har ferdigheter til å forsere en hindring, gå av sykkelen.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-[11px] font-bold text-emerald-800">6</span>
                <span>Unngå å sykle på spesielt sårbare stier like etter perioder med mye nedbør.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-[11px] font-bold text-emerald-800">7</span>
                <span>Ikke lag stien bredere ved å sykle utenom vanndammer eller hindringer.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-[11px] font-bold text-emerald-800">8</span>
                <span>Bær sykkelen gjennom myrområder slik at det ikke dannes dype spor.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-[11px] font-bold text-emerald-800">9</span>
                <span>Ikke lås bakhjulet i bratte nedoverbakker.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-[11px] font-bold text-emerald-800">10</span>
                <span>Dersom to syklister møtes i en bakke, har den som sykler oppover forkjørsrett.</span>
              </li>
            </ol>
          </div>
        </div>

        <!-- På snø & skiløyper (8 regler) -->
        <div class="rounded-2xl border border-gray-200 bg-white p-6 sm:p-8 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-100">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-sky-100 text-xl text-sky-700">
                ❄️
              </span>
              <div>
                <h3 class="text-lg font-bold text-dark">På snø &amp; i skiløyper (8 regler)</h3>
                <p class="text-xs text-gray-500">For fatbike og vintersykling</p>
              </div>
            </div>

            <ol class="space-y-3.5 text-xs sm:text-sm text-gray-700">
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-100 text-[11px] font-bold text-sky-800">1</span>
                <span>Vær hensynsfull og hyggelig i møte med skiløpere og gående.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-100 text-[11px] font-bold text-sky-800">2</span>
                <span><strong>Du har alltid vikeplikt i møte med skiløpere</strong> – de har lengre bremselengde og mindre kontroll.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-100 text-[11px] font-bold text-sky-800">3</span>
                <span>Ligg til høyre mellom skisporene, eventuelt helt til høyre hvis mulig.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-100 text-[11px] font-bold text-sky-800">4</span>
                <span>Brems ned til kontrollert fart når det kommer skiløper imot, og passer skiløpere i samme retning med varsomhet på venstre side.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-100 text-[11px] font-bold text-sky-800">5</span>
                <span>Vær spesielt observant i nedoverbakker – det tar lengre tid å bremse på snø enn på barmark.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-100 text-[11px] font-bold text-sky-800">6</span>
                <span>Unngå å krysse skisporet mer enn nødvendig.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-100 text-[11px] font-bold text-sky-800">7</span>
                <span>Unngå de mest populære utfartsstedene i kjernetiden på lørdager og søndager når trafikken er stor i skiløypene.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-100 text-[11px] font-bold text-sky-800">8</span>
