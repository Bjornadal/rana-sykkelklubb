<script>
  // Client-side category filtering for the park elements
  function initConceptFilter() {
    const buttons = document.querySelectorAll(".filter-btn");
    const cards = document.querySelectorAll(".concept-card");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.getAttribute("data-filter") || "all";

        // Update button states
        buttons.forEach((b) => {
          if (b === btn) {
            b.classList.add("bg-dark", "text-white", "shadow-xs");
            b.classList.remove("bg-gray-100", "text-gray-700");
          } else {
            b.classList.remove("bg-dark", "text-white", "shadow-xs");
            b.classList.add("bg-gray-100", "text-gray-700");
          }
        });

        // Filter cards
        cards.forEach((card) => {
          const levels = (card.getAttribute("data-levels") || "").split(" ");
          if (filter === "all" || levels.includes(filter)) {
            (card as HTMLElement).style.display = "flex";
          } else {
            (card as HTMLElement).style.display = "none";
          }
        });
      });
    });
  }

  // ScrollSpy for highlighting active subnav section
  function initScrollSpy() {
    const navLinks = document.querySelectorAll(".subnav-link");
    const sections = Array.from(navLinks)
      .map((link) => {
        const href = link.getAttribute("href");
        if (href && href.startsWith("#")) {
          return document.querySelector(href);
        }
        return null;
      })
      .filter(Boolean) as HTMLElement[];

    if (!("IntersectionObserver" in window)) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            navLinks.forEach((link) => {
              const isMatch = link.getAttribute("href") === `#${id}`;
              if (isMatch) {
                link.classList.add("bg-white/20", "text-white", "font-extrabold", "ring-1", "ring-white/25");
                link.classList.remove("text-slate-300");
              } else {
                link.classList.remove("bg-white/20", "text-white", "font-extrabold", "ring-1", "ring-white/25");
                link.classList.add("text-slate-300");
              }
            });
          }
        });
      },
      {
        rootMargin: "-15% 0px -70% 0px",
        threshold: 0,
      }
    );

    sections.forEach((sec) => observer.observe(sec));
  }

  // Initialize on load
  function init() {
    initConceptFilter();
    initScrollSpy();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
