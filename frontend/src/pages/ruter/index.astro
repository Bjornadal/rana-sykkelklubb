  </section>
</Layout>

<script>
  function initRouteFilters() {
    const searchInput = document.getElementById("route-search") as HTMLInputElement | null;
    const difficultySelect = document.getElementById("difficulty-filter") as HTMLSelectElement | null;
    const resetBtn = document.getElementById("reset-filters-btn");
    const cards = document.querySelectorAll(".route-card");
    const emptyMsg = document.getElementById("no-routes-message");

    let currentDifficulty = "all";
    let currentSearch = "";

    function applyFilters() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const diff = card.getAttribute("data-difficulty") || "";
        const searchContent = card.getAttribute("data-search") || "";

        const matchesDifficulty = currentDifficulty === "all" || diff === currentDifficulty;
        const matchesSearch = !currentSearch || searchContent.includes(currentSearch);

        if (matchesDifficulty && matchesSearch) {
          (card as HTMLElement).style.display = "flex";
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = "none";
        }
      });

      if (emptyMsg) {
        if (visibleCount === 0) {
          emptyMsg.classList.remove("hidden");
        } else {
          emptyMsg.classList.add("hidden");
        }
      }
    }

    // Search input
    searchInput?.addEventListener("input", (e) => {
      currentSearch = (e.target as HTMLInputElement).value.trim().toLowerCase();
      applyFilters();
    });

    // Difficulty dropdown
    difficultySelect?.addEventListener("change", (e) => {
      currentDifficulty = (e.target as HTMLSelectElement).value;
      applyFilters();
    });

    // Reset button
    resetBtn?.addEventListener("click", () => {
      currentDifficulty = "all";
      currentSearch = "";

      if (searchInput) searchInput.value = "";
      if (difficultySelect) difficultySelect.value = "all";

      applyFilters();
    });

    // Initial filter application on page load
    applyFilters();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRouteFilters);
  } else {
    initRouteFilters();
  }
</script>
