---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { url } from "../lib/url";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description = "Rana Sykkelklubb er sykkelklubben i Mo i Rana for barn, ungdom og voksne. Finn treninger, stier, turforslag, medlemskap og Rana Bike Park.",
  image = "/logo.png",
  type,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://ranasykkelklubb.no");
const normalizedPath =
  Astro.url.pathname === "/"
    ? "/"
    : `${Astro.url.pathname.replace(/\/+$/, "")}/`;

const canonicalUrl = new URL(normalizedPath, site).toString();
const ogImageUrl = new URL(image, site).toString();
const pageTitle =
  title === "Forside"
    ? "Rana Sykkelklubb | Sykling og sykkelmiljø i Mo i Rana"
    : title.includes("Rana Sykkelklubb")
      ? title
      : `${title} | Rana Sykkelklubb`;
const ogType = type ?? (normalizedPath.startsWith("/nyheter/") ? "article" : "website");
const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
---

<!doctype html>
<html lang="nb">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-5CS3FXHG');
    </script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="author" content="Rana Sykkelklubb" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href={new URL("/sitemap.xml", site).toString()} />
    <link rel="icon" type="image/png" href={url("/favicon.png")} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Rana Sykkelklubb" />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Rana Sykkelklubb" />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>
  </head>

  <body class="flex min-h-screen flex-col">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5CS3FXHG"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <Header />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
