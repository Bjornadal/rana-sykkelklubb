---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { url } from "../../lib/url";
import { fetchRoutes } from "../../lib/content";
import RouteMap from "../../components/RouteMap.astro";
import ElevationProfile from "../../components/ElevationProfile.astro";
import { routeTracks } from "../../lib/routeTracks";

export async function getStaticPaths() {
  const routes = await getCollection("ruter");
  return routes.map((route) => ({
    params: { slug: route.id.replace(/\.[^/.]+$/, "") },
    props: { route },
  }));
}

const { route } = Astro.props;
const { Content } = await render(route);

const slug = route.id.replace(/\.[^/.]+$/, "");
const trackData = routeTracks[slug] || {
  slug,
  title: route.data.title,
  discipline: route.data.discipline,
  color: "#e6361e",
  coordinates: [[66.3125, 14.1428], [66.3350, 14.2150]],
  waypoints: [],
};

const allRoutes = await fetchRoutes();
const relatedRoutes = allRoutes
  .filter((r) => r.slug !== slug)
  .slice(0, 3);

const disciplineColors: Record<string, { bg: string; text: string; border: string; icon: string }> = {
  Landevei: { bg: "bg-blue-500/20", text: "text-blue-200", border: "border-blue-400/40", icon: "🚴" },
  "Terreng / Sti": { bg: "bg-green-500/20", text: "text-green-200", border: "border-green-400/40", icon: "🏔️" },
  "Grus / Gravel": { bg: "bg-amber-500/20", text: "text-amber-200", border: "border-amber-400/40", icon: "🌾" },
  Enduro: { bg: "bg-red-500/20", text: "text-red-200", border: "border-red-400/40", icon: "🔥" },
};

const difficultyColors: Record<string, { bg: string; text: string; dot: string }> = {
  Enkel: { bg: "bg-emerald-100", text: "text-emerald-800", dot: "bg-emerald-500" },
  Middels: { bg: "bg-blue-100", text: "text-blue-800", dot: "bg-blue-500" },
  Krevende: { bg: "bg-rose-100", text: "text-rose-800", dot: "bg-rose-500" },
  Ekspert: { bg: "bg-slate-900", text: "text-white", dot: "bg-red-500" },
};

const disc = disciplineColors[route.data.discipline] || { bg: "bg-white/10", text: "text-white", border: "border-white/20", icon: "🚲" };
const diff = difficultyColors[route.data.difficulty] || { bg: "bg-gray-100", text: "text-gray-700", dot: "bg-gray-400" };
---

<Layout
  title={`${route.data.title} - Rute- og stibibliotek`}
  description={route.data.excerpt}
>
  <article>
    <!-- Header Hero -->
    <header class="relative isolate overflow-hidden bg-gradient-to-br from-dark via-dark-light to-primary-950 py-16 sm:py-24 text-white">
      {route.data.image && (
        <img
          src={url(route.data.image)}
          alt=""
          aria-hidden="true"
          class="absolute inset-0 -z-10 h-full w-full object-cover object-center opacity-30 mix-blend-overlay filter"
        />
      )}
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-gray-400 mb-6">
          <a href={url("/")} class="hover:text-white transition-colors">Forside</a>
          <span>/</span>
          <a href={url("/ruter")} class="hover:text-white transition-colors">Ruter</a>
          <span>/</span>
          <span class="text-primary-400 truncate max-w-xs">{route.data.title}</span>
        </nav>

        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class={`inline-flex items-center gap-1.5 rounded-lg border px-3 py-1 text-xs font-bold uppercase tracking-wider ${disc.bg} ${disc.text} ${disc.border}`}>
            <span>{disc.icon}</span>
            <span>{route.data.discipline}</span>
          </span>

          <span class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider ${diff.bg} ${diff.text}`}>
            <span class={`h-2 w-2 rounded-full ${diff.dot}`}></span>
            <span>{route.data.difficulty}</span>
          </span>
        </div>

        <h1 class="text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl uppercase">
          {route.data.title}
        </h1>

        <p class="mt-4 max-w-3xl text-base sm:text-lg leading-relaxed text-gray-200 font-normal">
          {route.data.excerpt}
        </p>

        <!-- Key Metrics Cards Row -->
        <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-4 rounded-2xl bg-white/10 backdrop-blur-md p-5 border border-white/15">
          <div>
            <span class="block text-xs font-bold uppercase tracking-wider text-gray-300">Distanse</span>
            <span class="mt-1 block text-2xl font-black text-white">{route.data.distanceKm} km</span>
          </div>
          <div>
            <span class="block text-xs font-bold uppercase tracking-wider text-gray-300">Total stigning</span>
            <span class="mt-1 block text-2xl font-black text-primary-400">{route.data.elevationM} hm</span>
          </div>
          <div>
            <span class="block text-xs font-bold uppercase tracking-wider text-gray-300">Underlag</span>
            <span class="mt-1 block text-sm font-semibold text-gray-200">{route.data.surface}</span>
          </div>
        </div>

        <!-- Action Buttons Bar -->
        <div class="mt-8 flex flex-wrap items-center gap-3">
          {route.data.gpxFile && (
            <a
              href={url(route.data.gpxFile)}
              download
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-500 px-6 py-3.5 text-sm font-bold uppercase tracking-wider text-white shadow-lg transition-all hover:bg-primary-600 hover:-translate-y-0.5 hover:shadow-primary-500/30"
            >
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              Last ned GPX-fil
            </a>
          )}

          {route.data.stravaUrl && (
            <a
              href={route.data.stravaUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-[#FC4C02]/60 bg-[#FC4C02]/20 px-4 py-3.5 text-xs font-bold uppercase tracking-wider text-white backdrop-blur-xs transition-all hover:bg-[#FC4C02] hover:text-white hover:-translate-y-0.5 shadow-xs"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7.008 13.828h4.172"/>
              </svg>
              <span>Se på Strava</span>
            </a>
          )}

          {route.data.komootUrl && (
            <a
              href={route.data.komootUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/30 bg-white/10 px-4 py-3.5 text-xs font-bold uppercase tracking-wider text-white backdrop-blur-xs transition-all hover:bg-white hover:text-dark hover:-translate-y-0.5"
            >
              <span>Komoot</span>
            </a>
          )}

          {route.data.trailguideUrl && (
            <a
              href={route.data.trailguideUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-emerald-500/50 bg-emerald-500/20 px-4 py-3.5 text-xs font-bold uppercase tracking-wider text-emerald-200 backdrop-blur-xs transition-all hover:bg-emerald-600 hover:text-white hover:-translate-y-0.5 shadow-xs"
            >
              <span>🌲 Trailguide.net</span>
            </a>
          )}

          {route.data.trailforksUrl && (
            <a
              href={route.data.trailforksUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-amber-500/50 bg-amber-500/20 px-4 py-3.5 text-xs font-bold uppercase tracking-wider text-amber-200 backdrop-blur-xs transition-all hover:bg-amber-600 hover:text-white hover:-translate-y-0.5 shadow-xs"
            >
              <span>🚵 Trailforks</span>
            </a>
          )}

          <button
            type="button"
            id="share-btn"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/30 bg-white/10 px-4 py-3.5 text-xs font-bold uppercase tracking-wider text-white backdrop-blur-xs transition-all hover:bg-white hover:text-dark hover:-translate-y-0.5"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
            </svg>
            <span id="share-btn-text">Del rute</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <div class="py-12 sm:py-16 bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        
        <div class="grid gap-12 lg:grid-cols-3">
          
          <!-- Left Main Column (Turbeskrivelse & Detaljer) -->
          <div class="lg:col-span-2">
            
            <!-- Interactive Leaflet Route Map -->
            <div class="mb-10">
              <RouteMap track={trackData} />
            </div>

            <!-- Strava Segments Highlight Banner (Only for real strava.com links) -->
            {trackData.stravaSegments && trackData.stravaSegments.filter(s => s.url.includes('strava.com')).length > 0 && (
              <div class="mb-10 rounded-2xl border border-orange-200 bg-gradient-to-br from-orange-50/70 to-white p-6 shadow-xs">
                <div class="flex items-center justify-between gap-4 mb-4">
                  <div class="flex items-center gap-2">
                    <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-[#FC4C02] text-white">
                      <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                        <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7.008 13.828h4.172"/>
                      </svg>
                    </span>
                    <div>
                      <h3 class="text-sm font-extrabold uppercase tracking-wider text-dark">
                        Strava-segmenter på denne ruten
                      </h3>
                      <p class="text-xs text-gray-500">Mål krefter og se ledertavler fra lokale syklister</p>
                    </div>
                  </div>
                  <span class="hidden sm:inline-block rounded-full bg-[#FC4C02]/10 px-2.5 py-1 text-[11px] font-bold text-[#FC4C02]">
                    Strava Live
                  </span>
                </div>

                <div class="grid gap-3 sm:grid-cols-2">
                  {trackData.stravaSegments.filter(s => s.url.includes('strava.com')).map((seg) => (
                    <div class="flex flex-col justify-between rounded-xl border border-gray-200 bg-white p-4 shadow-2xs">
                      <div>
                        <h4 class="font-bold text-dark text-sm">{seg.name}</h4>
                        <p class="mt-1 text-xs text-gray-600">{seg.description}</p>
                      </div>
                      <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-3 text-xs">
                        <div class="flex items-center gap-2 font-bold text-gray-700">
                          <span>{seg.distanceKm} km</span>
                          {seg.avgGradePercent !== undefined && (
                            <>
                              <span>·</span>
                              <span class="text-primary-600">{seg.avgGradePercent} % snitt</span>
                            </>
                          )}
                        </div>
                        <a
                          href={seg.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1 font-bold text-[#FC4C02] hover:text-[#e04000] transition-colors"
                        >
                          Åpne segment &rarr;
                        </a>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Highlights Box -->
            {route.data.highlights.length > 0 && (
              <div class="mb-10 rounded-2xl border border-primary-100 bg-primary-50/50 p-6">
                <h2 class="text-sm font-bold uppercase tracking-wider text-primary-800 mb-3 flex items-center gap-2">
                  <span>⭐</span>
                  Høydepunkter på denne turen
                </h2>
                <ul class="grid gap-2 sm:grid-cols-2 text-sm text-gray-700">
                  {route.data.highlights.map((hl) => (
                    <li class="flex items-start gap-2">
                      <svg class="mt-0.5 h-4 w-4 shrink-0 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{hl}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Genuine GPX Elevation Profile Visualizer -->
            <div class="mb-10">
              <ElevationProfile
                slug={slug}
                title={route.data.title}
                distanceKm={route.data.distanceKm}
                elevationM={route.data.elevationM}
              />
            </div>

            <!-- Markdown Rendered Content -->
            <div class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-dark prose-a:text-primary-600 prose-a:no-underline hover:prose-a:underline">
              <Content />
            </div>

            <!-- GPS Device Compatibility Guide Box -->
            <div class="mt-12 rounded-2xl border border-gray-200 bg-gray-50 p-6 sm:p-8">
              <h3 class="text-lg font-bold text-dark mb-2">Hvordan bruke GPX-filen?</h3>
              <p class="text-sm text-gray-600 mb-4 leading-relaxed">
                Når du laster ned GPX-sporet kan du enkelt importere det til din sykkelcomputer eller navigasjonsapp:
              </p>
              <div class="grid gap-3 sm:grid-cols-3 text-xs">
                <div class="rounded-xl bg-white p-4 border border-gray-200 shadow-2xs">
                  <strong class="block text-dark font-bold mb-1">Garmin Connect</strong>
                  <span class="text-gray-500">Åpne Garmin Connect web &rarr; Trening &rarr; Løyper &rarr; Importer rute.</span>
                </div>
                <div class="rounded-xl bg-white p-4 border border-gray-200 shadow-2xs">
                  <strong class="block text-dark font-bold mb-1">Wahoo ELEMNT</strong>
                  <span class="text-gray-500">Send GPX-filen direkte til ELEMNT Companion-appen på mobilen.</span>
                </div>
                <div class="rounded-xl bg-white p-4 border border-gray-200 shadow-2xs">
                  <strong class="block text-dark font-bold mb-1">Mobil / Strava</strong>
                  <span class="text-gray-500">Bruk Komoot, Trailforks, Strava eller OsmAnd for sanntidsnavigasjon.</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Sidebar (Metadata & Tips) -->
          <aside class="space-y-6 lg:col-span-1">
            
            <!-- Quick Facts Card -->
            <div class="rounded-2xl border border-gray-200 bg-gray-50/70 p-6 shadow-xs">
              <h3 class="text-sm font-bold uppercase tracking-wider text-dark mb-4 border-b border-gray-200 pb-3">
                Turbase &amp; Nøkkeldata
              </h3>
              <dl class="space-y-3.5 text-sm">
                <div>
                  <dt class="text-xs font-bold uppercase tracking-wider text-gray-500">Start- og sluttsted</dt>
                  <dd class="mt-0.5 font-medium text-dark">{route.data.startingPoint}</dd>
                </div>
                <div>
                  <dt class="text-xs font-bold uppercase tracking-wider text-gray-500">Distanse</dt>
                  <dd class="mt-0.5 font-extrabold text-dark">{route.data.distanceKm} km</dd>
                </div>
                <div>
                  <dt class="text-xs font-bold uppercase tracking-wider text-gray-500">Total stigning</dt>
                  <dd class="mt-0.5 font-extrabold text-primary-600">{route.data.elevationM} høydemeter</dd>
                </div>
                <div>
                  <dt class="text-xs font-bold uppercase tracking-wider text-gray-500">Vanskelighetsgrad</dt>
                  <dd class="mt-0.5">
                    <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-bold ${diff.bg} ${diff.text}`}>
                      <span class={`h-2 w-2 rounded-full ${diff.dot}`}></span>
                      {route.data.difficulty}
                    </span>
                  </dd>
                </div>
                <div>
                  <dt class="text-xs font-bold uppercase tracking-wider text-gray-500">Underlag</dt>
                  <dd class="mt-0.5 text-gray-700">{route.data.surface}</dd>
                </div>
              </dl>

              {route.data.gpxFile && (
                <div class="mt-6 pt-6 border-t border-gray-200">
                  <a
                    href={url(route.data.gpxFile)}
                    download
                    class="flex w-full items-center justify-center gap-2 rounded-xl bg-dark px-4 py-3 text-xs font-bold uppercase tracking-wider text-white shadow-sm hover:bg-primary-600 transition-colors"
                  >
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    Last ned GPX
                  </a>
                </div>
              )}
            </div>
          </aside>
        </div>

        <!-- Related routes footer section -->
        {relatedRoutes.length > 0 && (
          <div class="mt-20 border-t border-gray-200 pt-12">
            <h3 class="text-2xl font-bold uppercase tracking-tight text-dark mb-8">
              Flere turforslag du kanskje vil like
            </h3>
            <div class="grid gap-6 sm:grid-cols-3">
              {relatedRoutes.map((r) => (
                <a
                  href={url(`/ruter/${r.slug}`)}
                  class="group rounded-xl border border-gray-200 bg-white p-5 shadow-2xs hover:shadow-md hover:border-primary-300 transition-all flex flex-col justify-between"
                >
                  <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-primary-600">{r.discipline}</span>
                    <h4 class="mt-1 text-base font-bold text-dark group-hover:text-primary-600 transition-colors">{r.title}</h4>
                    <p class="mt-1.5 text-xs text-gray-500 line-clamp-2">{r.excerpt}</p>
                  </div>
                  <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-3 text-xs font-bold text-gray-600">
                    <span>{r.distanceKm} km</span>
                    <span>{r.elevationM} hm</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </article>
</Layout>

<script>
  // Copy current URL to clipboard
  const shareBtn = document.getElementById("share-btn");
  const shareText = document.getElementById("share-btn-text");

  shareBtn?.addEventListener("click", async () => {
    try {
      if (navigator.clipboard) {
        await navigator.clipboard.writeText(window.location.href);
        if (shareText) {
          shareText.textContent = "Lenke kopiert! ✓";
          setTimeout(() => {
            shareText.textContent = "Del rute";
          }, 2500);
        }
      }
    } catch (err) {
      console.warn("Could not copy URL:", err);
    }
  });
</script>
