const values = [
  {
    icon: "👥",
    title: "Fellesskap og inkludering",
    description:
      "Et gratis og sosialt møtested for barn, ungdom, familier og voksne – uavhengig av ferdighetsnivå og medlemskap i sykkelklubben.",
  },
  {
    icon: "❤️",
    title: "Folkehelse og mestring",
    description:
      "Et attraktivt lavterskeltilbud som gjør fysisk aktivitet morsomt og gir naturlig progresjon i balanse, teknikk og sykkelferdigheter.",
  },
  {
    icon: "🏔️",
    title: "Bolyst og attraktivitet",
    description:
      "Et moderne sykkelanlegg styrker Skillevollen som aktivitetsområde og bidrar til å gjøre Rana mer attraktiv for både innbyggere og besøkende.",
